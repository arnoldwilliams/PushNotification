<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PushNotification.App.ViewModels"
             x:Class="PushNotification.App.Views.DeviceInfoPage"
             x:DataType="vm:DeviceInfoViewModel"
             Title="Device &amp; registration">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Installation details"
                   FontSize="20"
                   FontAttributes="Bold" />
            <Label Text="These values are sent to the backend when the device registers for push notifications."
                   FontSize="13"
                   TextColor="{AppThemeBinding Light=#5A5A5A, Dark=#B8B8B8}" />
            <Label Text="{Binding PermissionStatus, StringFormat='Notification permission: {0}'}"
                   FontSize="12"
                   FontAttributes="Italic"
                   TextColor="{AppThemeBinding Light=#5A5A5A, Dark=#B8B8B8}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Rows}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DeviceInfoRow">
                    <Grid ColumnDefinitions="140,*" Padding="0,6">
                        <Label Grid.Column="0"
                               Text="{Binding Label}"
                               FontSize="13"
                               FontAttributes="Bold" />
                        <Label Grid.Column="1"
                               Text="{Binding Value}"
                               FontSize="13"
                               LineBreakMode="TailTruncation" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />
            <Label Text="{Binding StatusMessage}"
                   FontSize="12"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#5A5A5A, Dark=#B8B8B8}" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Grid.Column="0"
                        Text="Register"
                        Command="{Binding RegisterCommand}" />
                <Button Grid.Column="1"
                        Text="Save"
                        Command="{Binding SaveInstallationCommand}" />
                <Button Grid.Column="2"
                        Text="Unregister"
                        Command="{Binding UnregisterCommand}" />
            </Grid>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
